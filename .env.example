# Copy to .env and replace every value before running `docker compose up`.
# Generate a JWT secret:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_base64_at_least_32_bytes
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME
# Origins allowed to call the ML API from a browser
CORS_ORIGINS=http://localhost:4200
